# DiscoveryHub environment configuration.
#
#   cp .env.example .env      then fill in the values below
#
# docker compose reads .env automatically. NEVER commit .env — it is
# gitignored, and these are real credentials.
 
# -----------------------------------------------------------------------------
# AWS S3 — attachments (archive-service) and export packages (export-service)
# -----------------------------------------------------------------------------
# Read by the AWS SDK's default credentials provider chain. Prefer an IAM user
# scoped to just the two buckets below, with s3:GetObject, s3:PutObject,
# s3:DeleteObject and s3:ListBucket. If you use temporary credentials, also set
# AWS_SESSION_TOKEN.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
 
# Bucket names must be globally unique across all of AWS, so prefix them.
AWS_S3_ATTACHMENTS_BUCKET=discoveryhub-attachments
AWS_S3_EXPORTS_BUCKET=discoveryhub-exports
 
# Leave both unset for real AWS. Set them to point the same code at any
# S3-compatible endpoint (LocalStack, a VPC endpoint) — useful for an offline
# demo, since path-style addressing is what most such servers require.
AWS_S3_ENDPOINT=
AWS_S3_PATH_STYLE=false
 
# -----------------------------------------------------------------------------
# MongoDB — archived message bodies (archive-service)
# -----------------------------------------------------------------------------
# Leave unset to use the local mongo container that docker compose starts.
# To use Atlas, put the full connection string here, including the database:
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/archive_<yourname>?retryWrites=true&w=majority
# Remember to allow your IP in the Atlas Network Access list.
#
# Use YOUR OWN database name in the path (archive_<yourname>). If the team shares
# one Atlas cluster, two machines pointed at the same database both write into it:
# message counts then include everyone's data, and one person resetting their
# environment deletes the corpus on every other machine. Atlas creates the
# database on the first write, so there is nothing to set up.
MONGODB_URI=
 
# -----------------------------------------------------------------------------
# PostgreSQL — case, hold, export and audit databases
# -----------------------------------------------------------------------------
# Defaults to the local container that docker compose starts, which is the
# recommended setup: NFR-4 asks for single-command startup on a laptop, and a
# managed instance makes a live demo depend on the venue's network.
#
# S3 and Atlas are cloud-hosted because they hold the evidence corpus and the
# export packages — the artifacts an e-discovery platform must retain durably
# and produce years later. These four databases hold per-demo operational
# state that is regenerated on every run, so hosting them buys nothing.
POSTGRES_USER=discoveryhub
POSTGRES_PASSWORD=discoveryhub
 
# To move a database to a managed instance (RDS, Neon, Supabase), point its URL
# here — no code changes. Create the database first; init-postgres.sh only runs
# against the local container.
#   CASE_DB_URL=jdbc:postgresql://your-host:5432/case_db
#   HOLD_DB_URL=jdbc:postgresql://your-host:5432/hold_db
#   EXPORT_DB_URL=jdbc:postgresql://your-host:5432/export_db
#   AUDIT_DB_URL=jdbc:postgresql://your-host:5432/audit_db
#
# NOTE for audit_db: the append-only triggers (FR-7.3) are installed by the
# service on startup, so they follow the database wherever it lives.
 
# -----------------------------------------------------------------------------
# Demo tuning
# -----------------------------------------------------------------------------
# FR-5.1 requires retention to be settable to minutes for the demo. The
# disposition job is hourly by default; every 30 seconds makes it observable.
DISPOSITION_CRON=0 0 * * * *
DISPOSITION_ENABLED=true
 
# FR-6.4: how long an export download link stays valid.
EXPORT_LINK_EXPIRY_MINUTES=30
 
